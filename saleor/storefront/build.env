# 前台打包参数（生产环境 https://pinso.top），GitHub 打包（.github/workflows/storefront.yml）与 deploy/deploy.sh 共用。
# NEXT_PUBLIC_* 在打包时写入页面代码，修改后需要重新打包；运行时的密钥在服务器 /opt/pinso/.env 中（见 deploy/docker-compose.yml）。
NEXT_PUBLIC_SALEOR_API_URL=https://pinso.top/graphql/
NEXT_PUBLIC_STOREFRONT_URL=https://pinso.top
# 渠道（币种）：cn 人民币 / global 美元 / jp 日元，网址 /{语言}/{渠道}/…
NEXT_PUBLIC_DEFAULT_CHANNEL=cn
STOREFRONT_CHANNELS=cn,global,jp
# 语言：zh 简体中文 / en 英文 / ja 日文
NEXT_PUBLIC_DEFAULT_LOCALE=zh
NEXT_PUBLIC_STOREFRONT_LOCALES=zh,en,ja
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Asia/Shanghai
# 目前使用 Saleor 自带的测试支付（mirumee.payments.dummy），接入 Stripe 后改为 false
NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT=true
# 商品图直接使用 Saleor 生成的缩略图，不再经 Next 重新压缩（节省服务器资源）
NEXT_IMAGE_UNOPTIMIZED=true
NEXT_OUTPUT=standalone
NEXT_TELEMETRY_DISABLED=1
