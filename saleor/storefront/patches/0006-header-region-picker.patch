+/** PINSO: language + currency picker next to the search bar (same options as the footer picker). */
+export async function HeaderRegionSlot() {
+	const resolvedSlugs = needsAsyncChannelDiscovery()
+		? await getStorefrontChannelSlugs()
+		: getStaticStorefrontChannelSlugs();
+	const channels = shouldFetchChannelMetadata(resolvedSlugs) ? await getCachedChannelsList() : null;
+	const selectorChannels =
+		channels?.channels && resolvedSlugs.length > 0
+			? toChannelSelectOptions(channels.channels, resolvedSlugs)
+			: [];
+
+	return (
+		<StorefrontRegionPicker
+			locales={getStorefrontLocaleOptions()}
+			channels={selectorChannels}
+			placement="header"
+		/>
+	);
+}
