+/**
+ * PINSO: pay with Saleor's built-in dummy payment plugin (`mirumee.payments.dummy`, Payment API).
+ * The amount is always the live checkout total; only allowed where dummy payment is enabled.
+ */
+export async function createLegacyCheckoutPayment(input: {
+	checkoutId: string;
+	gatewayId: string;
+}): Promise<SimpleActionResult> {
+	const { server: t } = await getCheckoutServerTranslations();
+
+	if (input.gatewayId !== "mirumee.payments.dummy" || getDummyPaymentGuardError(input.gatewayId)) {
+		return { ok: false, error: t("dummyNotAllowed") };
+	}
+
+	const live = await fetchCheckoutOnServer(input.checkoutId);
+	const amount = live.ok && live.checkout ? getCheckoutPayAmount(live.checkout) : null;
+	if (amount === null) {
+		return { ok: false, error: t("totalVerifyFailed") };
+	}
+
+	const result = await executeAuthenticatedGraphQL(checkoutPaymentCreateDocument, {
+		variables: {
+			checkoutId: input.checkoutId,
+			// Dummy plugin tokens: "charged" simulates a fully charged payment
+			input: { gateway: input.gatewayId, token: "charged", amount },
+		},
+		cache: "no-cache",
+	});
+
+	if (!result.ok) {
+		return { ok: false, error: result.error.message };
+	}
+	const error = result.data.checkoutPaymentCreate?.errors[0];
+	if (error) {
+		return { ok: false, error: error.message ?? t("paymentProcessFailed") };
+	}
+	return { ok: true };
+}
