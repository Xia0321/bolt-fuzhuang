diff --git a/src/app/(checkout)/city-choices-action.ts b/src/app/(checkout)/city-choices-action.ts
new file mode 100644
index 0000000..fd2b228
--- /dev/null
+++ b/src/app/(checkout)/city-choices-action.ts
@@ -0,0 +1,34 @@
+"use server";
+
+import { executeRawGraphQL } from "@/lib/graphql";
+
+/**
+ * PINSO: cities Saleor's address database knows for a country area (e.g. CN provinces).
+ * Saleor rejects a free-text city outside this list, so the checkout address form
+ * renders a dropdown whenever the list is non-empty.
+ */
+const CITY_CHOICES_QUERY = `
+  query PinsoCityChoices($countryCode: CountryCode!, $countryArea: String!) {
+    addressValidationRules(countryCode: $countryCode, countryArea: $countryArea) {
+      cityChoices { raw verbose }
+    }
+  }
+`;
+
+export type CityChoice = { value: string; label: string };
+
+export async function getCityChoices(countryCode: string, countryArea: string): Promise<CityChoice[]> {
+	if (!/^[A-Z]{2}$/.test(countryCode) || !countryArea || countryArea.length > 100) return [];
+	const result = await executeRawGraphQL<{
+		addressValidationRules: { cityChoices: Array<{ raw: string | null; verbose: string | null }> } | null;
+	}>({ query: CITY_CHOICES_QUERY, variables: { countryCode, countryArea } });
+	if (!result.ok) return [];
+	const seen = new Set<string>();
+	const choices: CityChoice[] = [];
+	for (const { raw, verbose } of result.data.addressValidationRules?.cityChoices ?? []) {
+		if (!raw || seen.has(raw)) continue;
+		seen.add(raw);
+		choices.push({ value: raw, label: verbose || raw });
+	}
+	return choices;
+}
