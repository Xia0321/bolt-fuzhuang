@@ -1,4 +1,5 @@
 import { defaultStorefrontContent } from "@/lib/content/defaults";
+import { executeRawGraphQL } from "@/lib/graphql";
 import { saleorContentProvider } from "@/lib/content/saleor/saleor-provider";
 import type { ContentProviderId, StorefrontContent, StorefrontContentRequest } from "@/lib/content/types";
 
@@ -40,6 +41,57 @@ export function resolveContentProvider(): ContentProvider {
 	}
 }
 
+/**
+ * PINSO: the free-shipping threshold comes from the channel's shipping methods in Saleor
+ * (the lowest "minimum order price" among methods that cost 0), so it is configured in one
+ * place — Dashboard → Shipping — instead of being duplicated in the policies Model.
+ * No free method → `null` (free-shipping copy and progress bar are hidden).
+ * When the lookup fails, the Model / code default value is kept.
+ */
+const FREE_SHIPPING_QUERY = `
+  query PinsoFreeShippingThreshold($channel: String!) {
+    shop {
+      availableShippingMethods(channel: $channel) {
+        price { amount }
+        minimumOrderPrice { amount }
+      }
+    }
+  }
+`;
+
+type FreeShippingResult = {
+	shop: {
+		availableShippingMethods: Array<{
+			price: { amount: number } | null;
+			minimumOrderPrice: { amount: number } | null;
+		}> | null;
+	};
+};
+
+async function resolveFreeShippingThreshold(channel: string): Promise<number | null | undefined> {
+	const result = await executeRawGraphQL<FreeShippingResult>({
+		query: FREE_SHIPPING_QUERY,
+		variables: { channel },
+	});
+	if (!result.ok) return undefined;
+	const freeMethods = (result.data.shop.availableShippingMethods ?? []).filter(
+		(method) => method.price?.amount === 0,
+	);
+	if (freeMethods.length === 0) return null;
+	return Math.min(...freeMethods.map((method) => method.minimumOrderPrice?.amount ?? 0));
+}
+
 export async function loadStorefrontContent(request: StorefrontContentRequest): Promise<StorefrontContent> {
-	return resolveContentProvider().load(request);
+	const [content, freeShippingThreshold] = await Promise.all([
+		resolveContentProvider().load(request),
+		resolveFreeShippingThreshold(request.channel),
+	]);
+	if (freeShippingThreshold === undefined) return content;
+	return {
+		...content,
+		policies: {
+			...content.policies,
+			shipping: { ...content.policies.shipping, freeShippingThreshold },
+		},
+	};
 }
