diff --git a/src/categories/components/CreateCategoryDialog/pinsoTranslations.ts b/src/categories/components/CreateCategoryDialog/pinsoTranslations.ts
new file mode 100644
index 0000000..4321ac6
--- /dev/null
+++ b/src/categories/components/CreateCategoryDialog/pinsoTranslations.ts
@@ -0,0 +1,141 @@
+// PINSO：新建分类时补充其他语言翻译。
+// 调用商品导入服务（deploy/product-importer）的 /api/translate-fields，由 Claude 翻译名称和描述，
+// 分类创建成功后通过 categoryTranslate 保存各语言翻译。
+import { type ApolloClient } from "@apollo/client";
+import { createFetch } from "@dashboard/graphql/authFetch";
+import { UpdateCategoryTranslationsDocument } from "@dashboard/graphql/hooks.generated";
+import { LanguageCodeEnum } from "@dashboard/graphql/types.generated";
+import { getParsedDataForJsonStringField } from "@dashboard/utils/richText/misc";
+import { type OutputData } from "@editorjs/editorjs";
+
+export interface LocalizedFields {
+  name: string;
+  description: string;
+}
+
+// 站点主语言为中文，需要补充的语言
+export const TRANSLATION_LANGUAGES = [
+  { code: LanguageCodeEnum.EN, key: "en", label: "English" },
+  { code: LanguageCodeEnum.JA, key: "ja", label: "日本語" },
+] as const;
+
+export type CategoryTranslations = Partial<Record<LanguageCodeEnum, LocalizedFields>>;
+
+// 线上与后台同域，使用相对路径；本地开发可在浏览器控制台设置
+// localStorage.setItem("pinsoImporterUrl", "http://localhost:8200/importer")
+const importerUrl = (): string => {
+  try {
+    return localStorage.getItem("pinsoImporterUrl") || "/importer";
+  } catch {
+    return "/importer";
+  }
+};
+
+// 自动附带当前员工的登录凭证，快过期时先续期
+const authFetch = createFetch({ refreshOnUnauthorized: false });
+
+export const fetchCategoryTranslations = async (
+  name: string,
+  description: string,
+): Promise<CategoryTranslations> => {
+  let response: Response;
+
+  try {
+    response = await authFetch(`${importerUrl()}/api/translate-fields`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ name, description }),
+    });
+  } catch {
+    throw new Error("无法连接翻译服务，请稍后重试");
+  }
+
+  const data = await response.json().catch(() => ({}));
+
+  if (!response.ok) {
+    throw new Error(data.error || `翻译失败（HTTP ${response.status}）`);
+  }
+
+  return Object.fromEntries(
+    TRANSLATION_LANGUAGES.map(lang => [
+      lang.code,
+      { name: data[lang.key]?.name ?? "", description: data[lang.key]?.description ?? "" },
+    ]),
+  );
+};
+
+// 用英文名生成网址标识（slug），如 "Straight Leg Jeans" → "straight-leg-jeans"；生成不了时返回空字符串
+export const englishSlug = (translations: CategoryTranslations | null | undefined): string =>
+  (translations?.[LanguageCodeEnum.EN]?.name ?? "")
+    .toLowerCase()
+    .normalize("NFKD")
+    .replace(/[\u0300-\u036f]/g, "")
+    .replace(/&/g, " and ")
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 80);
+
+// 用指定的网址标识创建；标识被占用时依次尝试 -2、-3…（最多 6 次）。baseSlug 为空时按 Saleor 默认方式创建
+export const createWithSlug = async <T>(
+  baseSlug: string,
+  create: (slug: string) => Promise<T>,
+  isSlugTaken: (result: T) => boolean,
+): Promise<T> => {
+  for (let attempt = 0; ; attempt++) {
+    const slug = baseSlug && attempt ? `${baseSlug}-${attempt + 1}` : baseSlug;
+    const result = await create(slug);
+
+    if (!baseSlug || !isSlugTaken(result) || attempt >= 5) {
+      return result;
+    }
+  }
+};
+
+const plainTextToEditorJs = (text: string): OutputData => ({
+  blocks: text
+    .split("\n")
+    .map(line => line.trim())
+    .filter(Boolean)
+    .map(line => ({ type: "paragraph", data: { text: line } })),
+});
+
+// 分类创建成功后保存翻译，返回保存失败的语言名称
+export const saveCategoryTranslations = async (
+  client: ApolloClient<object>,
+  categoryId: string,
+  translations: CategoryTranslations,
+): Promise<string[]> => {
+  const failed: string[] = [];
+
+  for (const lang of TRANSLATION_LANGUAGES) {
+    const fields = translations[lang.code];
+
+    if (!fields?.name.trim()) {
+      continue;
+    }
+
+    try {
+      const result = await client.mutate({
+        mutation: UpdateCategoryTranslationsDocument,
+        variables: {
+          id: categoryId,
+          language: lang.code,
+          input: {
+            name: fields.name.trim(),
+            description: fields.description.trim()
+              ? getParsedDataForJsonStringField(plainTextToEditorJs(fields.description))
+              : null,
+          },
+        },
+      });
+
+      if (result.data?.categoryTranslate?.errors?.length) {
+        failed.push(lang.label);
+      }
+    } catch {
+      failed.push(lang.label);
+    }
+  }
+
+  return failed;
+};
