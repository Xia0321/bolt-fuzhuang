+import { ThemeProvider } from "@saleor/macaw-ui-next";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useLocation } from "react-router";
+import { MemoryRouter } from "react-router-dom";
+
+import { ItemGroup } from "./ItemGroup";
+import { type SidebarMenuItem } from "./types";
+
+jest.mock("./Item", () => ({
+  MenuItem: ({ menuItem }: { menuItem: SidebarMenuItem }) => <span>{menuItem.label}</span>,
+}));
+
+const menuItem = {
+  id: "customers",
+  label: "客户",
+  url: "/customers",
+  type: "itemGroup",
+  children: [{ id: "all", label: "全部", url: "/customers/all", type: "item" }],
+} as SidebarMenuItem;
+
+const Location = () => <span data-test-id="location">{useLocation().pathname}</span>;
+
+const setup = (path: string) =>
+  render(
+    <ThemeProvider>
+      <MemoryRouter initialEntries={[path]}>
+        <ItemGroup menuItem={menuItem} />
+        <Location />
+      </MemoryRouter>
+    </ThemeProvider>,
+  );
+
+const isExpanded = () =>
+  document.querySelector("button[aria-expanded]")?.getAttribute("aria-expanded") === "true";
+
+describe("ItemGroup（PINSO：点父菜单文字切换展开 / 收起）", () => {
+  it("未展开时点文字：展开并打开该组页面", async () => {
+    setup("/orders");
+    expect(isExpanded()).toBe(false);
+
+    await userEvent.click(screen.getByText("客户"));
+
+    expect(isExpanded()).toBe(true);
+    expect(screen.getByTestId("location")).toHaveTextContent("/customers");
+  });
+
+  it("已展开时点文字：收起，不跳转", async () => {
+    setup("/customers");
+    expect(isExpanded()).toBe(true);
+
+    await userEvent.click(screen.getByText("客户"));
+
+    expect(isExpanded()).toBe(false);
+    expect(screen.getByTestId("location")).toHaveTextContent("/customers");
+  });
+
+  it("收起后再点文字：重新展开", async () => {
+    setup("/customers");
+
+    await userEvent.click(screen.getByText("客户"));
+    await userEvent.click(screen.getByText("客户"));
+
+    expect(isExpanded()).toBe(true);
+  });
+});
