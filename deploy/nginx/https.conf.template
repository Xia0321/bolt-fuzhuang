# HTTPS：证书申请成功后，由 deploy.sh 把 __DOMAIN__ 替换为实际域名，部署为 /etc/nginx/sites-enabled/pinso
upstream saleor_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

# 80 端口：保留证书验证路径，其余全部 301 跳转到 https://主域名
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

# www 与直接用 IP 访问：统一跳转到不带 www 的主域名
server {
    listen 443 ssl http2 default_server;
    server_name www.__DOMAIN__ _;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/nginx/pinso/ssl.conf;

    return 301 https://__DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/nginx/pinso/ssl.conf;

    include /etc/nginx/pinso/locations.conf;
}
